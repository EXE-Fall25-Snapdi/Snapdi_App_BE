# Database Configuration
# For PostgreSQL (Render/Production)
CONNECTION_STRING=Host=your-postgres-host;Port=5432;Database=your-database;Username=your-username;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

# For SQL Server (Local Development)
# CONNECTION_STRING=Data Source=.;Initial Catalog=Snapdi_DB_v2u1;Persist Security Info=True;User ID=sa;Password=12345;Encrypt=False

# JWT Configuration
JWT_KEY=your-super-secret-jwt-key-minimum-32-characters-long-for-security
JWT_ISSUER=SnapdiAPI
JWT_AUDIENCE=SnapdiClient
JWT_EXPIRATION_HOURS=24

# App Configuration
APP_BASE_URL=http://localhost:8080

# Environment
ASPNETCORE_ENVIRONMENT=Development
