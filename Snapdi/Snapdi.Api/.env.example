# JWT Configuration
JWT_KEY=your-secret-jwt-key-here-make-it-long-and-secure
JWT_ISSUER=Snapdi.Api
JWT_AUDIENCE=Snapdi.Client
JWT_EXPIRATION_HOURS=1

# Application Configuration
APP_BASE_URL=https://localhost:7000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@snapdi.com
FROM_NAME=Snapdi Team

# Email Settings
SMTP_ENABLE_SSL=true
SMTP_USE_DEFAULT_CREDENTIALS=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=snapdi_default

# PayOS Configuration
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=https://localhost:7000/api/Payment/Checkout/PaymentCallbackPayOS
PAYOS_CANCEL_URL=https://localhost:7000/api/Payment/Checkout/PaymentCallbackPayOS

